# Copie para backend/.env e ajuste se necessário.

# Postgres do docker-compose (porta 5434 na máquina)
DATABASE_URL="postgresql://leiloes:leiloes@localhost:5434/leiloes?schema=public"
# Conexão direta usada pelas migrations. Local: igual à DATABASE_URL.
# Em produção (Neon): DATABASE_URL = string do POOLER (+ &pgbouncer=true), DIRECT_URL = string direta.
DIRECT_URL="postgresql://leiloes:leiloes@localhost:5434/leiloes?schema=public"

PORT=3333

# Endereço(s) do front autorizados no CORS, separados por vírgula (sem "/" no final).
# Obrigatório em produção (ex.: https://casa-de-leiloes.vercel.app).
CORS_ORIGIN="http://localhost:5173"

# Segredo para assinar os tokens JWT. Gere um valor aleatório longo, ex.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"
JWT_EXPIRES_IN="1d"

# API do Art Institute of Chicago (opcional; estes são os padrões)
# AIC_API_URL="https://api.artic.edu/api/v1"
# AIC_USER_AGENT="casa-de-leiloes-verzel"

# Segredo da auditoria (HMAC da corrente de hashes e dos apelidos). NUNCA guardar no banco.
# Gere do mesmo jeito que o JWT_SECRET, com um valor DIFERENTE.
AUDIT_SECRET="troque-por-outro-segredo-longo-e-aleatorio"

# URL pública do front, usada nos links dos e-mails (padrão: a 1ª origem do CORS_ORIGIN)
# APP_URL="http://localhost:5173"

# E-mails transacionais (Resend). Desligados por padrão: sem EMAIL_ENABLED=true E uma chave,
# os envios são ignorados (com log). Contas @demo.com nunca recebem e-mail.
EMAIL_ENABLED=false
RESEND_API_KEY=""
# Remetente de um domínio verificado no Resend. "onboarding@resend.dev" serve para testes,
# mas o Resend só entrega no e-mail do dono da conta.
EMAIL_FROM="Casa de Leilões <onboarding@resend.dev>"
